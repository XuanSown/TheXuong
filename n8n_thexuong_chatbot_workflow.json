{
  "name": "TheXuong AI Chatbot - Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"]
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "id": "trigger-node",
      "name": "Telegram Trigger",
      "webhookId": "thexuong-bot-trigger",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot TheXuong"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8080/api/chatbot/products",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "keyword",
              "value": "={{ $json.message.text.split(' ').slice(0, 3).join(' ') }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Chatbot-API-Key",
              "value": "TheXuongSecretKey2026"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 0],
      "id": "product-api-node",
      "name": "Lay San Pham Tu DB"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'qwen2.5:3b', prompt: `Ban la tro ly ban hang cua cua hang do the thao TheXuong. Hay tra loi khach hang bang tieng Viet, than thien va ngan gon.\\n\\nDu lieu san pham tu kho hang:\\n${JSON.stringify($json.data || []).substring(0, 2000)}\\n\\nKhach hang hoi: \"${$('Telegram Trigger').item.json.message.text}\"\\n\\nHay tra loi khach hang dua tren du lieu san pham o tren. Neu khach hoi san pham khong co trong danh sach, hay noi rang shop khong co san pham do. Neu khach chao hoi binh thuong, hay chao lai than thien. Luon xung la \"TheXuong Shop\".`, stream: false }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 0],
      "id": "ai-qwen-node",
      "name": "AI Qwen Xu Ly"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.response }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 0],
      "id": "telegram-reply-node",
      "name": "Tra Loi Khach Hang",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot TheXuong"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Lay San Pham Tu DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lay San Pham Tu DB": {
      "main": [
        [
          {
            "node": "AI Qwen Xu Ly",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Qwen Xu Ly": {
      "main": [
        [
          {
            "node": "Tra Loi Khach Hang",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
